# =========================================================
# LOAD MOVIES
# =========================================================

def load_movies():

    if not os.path.exists(
        MOVIES_FILE
    ):

        raise RuntimeError(
            "movies.json not found"
        )


    with open(
        MOVIES_FILE,
        "r",
        encoding="utf-8"
    ) as file:

        data = json.load(
            file
        )


    items = data.get(
        "items",
        []
    )


    if not isinstance(
        items,
        list
    ):

        raise RuntimeError(
            "movies.json items must be a list"
        )


    return items


# =========================================================
# LOAD POSTED
# =========================================================

def load_posted():

    if not os.path.exists(
        POSTED_FILE
    ):

        return set()


    try:

        with open(
            POSTED_FILE,
            "r",
            encoding="utf-8"
        ) as file:

            data = json.load(
                file
            )


        if not isinstance(
            data,
            list
        ):

            return set()


        return set(
            str(value)
            for value in data
            if str(value).strip()
        )


    except Exception as error:

        print(
            f"WARNING: could not read "
            f"{POSTED_FILE}: {error}"
        )

        return set()


# =========================================================
# SAVE POSTED
# =========================================================

def save_posted(
    posted
):

    with open(
        POSTED_FILE,
        "w",
        encoding="utf-8"
    ) as file:

        json.dump(
            sorted(
                list(posted)
            ),
            file,
            ensure_ascii=False,
            indent=2
        )


# =========================================================
# LOAD ROTATION
# =========================================================

def load_rotation():

    default = {
        "index": 0
    }


    if not os.path.exists(
        ROTATION_FILE
    ):

        return default


    try:

        with open(
            ROTATION_FILE,
            "r",
            encoding="utf-8"
        ) as file:

            data = json.load(
                file
            )


        if not isinstance(
            data,
            dict
        ):

            return default


        return {

            "index": int(
                data.get(
                    "index",
                    0
                )
            )

        }


    except Exception as error:

        print(
            f"WARNING: could not read "
            f"{ROTATION_FILE}: {error}"
        )

        return default


# =========================================================
# SAVE ROTATION
# =========================================================

def save_rotation(
    rotation
):

    with open(
        ROTATION_FILE,
        "w",
        encoding="utf-8"
    ) as file:

        json.dump(
            rotation,
            file,
            ensure_ascii=False,
            indent=2
        )


# =========================================================
# CLEAN TEXT
# =========================================================

def clean_text(
    value
):

    if value is None:

        return ""


    return " ".join(
        str(value).split()
    ).strip()


# =========================================================
# MEDIA TYPE
# =========================================================

def get_media_type(
    item
):

    item_type = clean_text(
        item.get(
            "type",
            ""
        )
    ).lower()


    if item_type in (
        "فيلم",
        "movie",
        "film"
    ):

        return "movie"


    return "tv"


# =========================================================
# ARABIC TYPE
# =========================================================

def get_arabic_type(
    media_type
):

    if media_type == "movie":

        return "فيلم"


    return "مسلسل"


# =========================================================
# MOVIE KEY
# =========================================================

def get_movie_key(
    item
):

    movie_id = clean_text(
        item.get(
            "id",
            ""
        )
    )


    if not movie_id:

        return ""


    return (
        f"{get_media_type(item)}:"
        f"{movie_id}"
    )


# =========================================================
# MOVIE URL
# =========================================================

def get_movie_url(
    item
):

    movie_id = clean_text(
        item.get(
            "id",
            ""
        )
    )


    if not movie_id:

        return SITE_URL


    return (
        SITE_URL
        + "?movie="
        + get_media_type(item)
        + "-"
        + movie_id
    )


# =========================================================
# GENRES
# =========================================================

def get_genres_list(
    item
):

    genres = item.get(
        "genres",
        []
    )


    if isinstance(
        genres,
        list
    ):

        return [

            clean_text(
                genre
            )

            for genre in genres

            if clean_text(
                genre
            )

        ]


    value = clean_text(
        genres
    )


    if value:

        return [value]


    return []


# =========================================================
# GENRE MATCH
# =========================================================

def genre_matches(
    item,
    wanted_genre
):

    genres = get_genres_list(
        item
    )


    if wanted_genre in genres:

        return True


    if wanted_genre == "أكشن":

        return (

            "أكشن" in genres

            or

            "أكشن ومغامرة" in genres

        )


    if wanted_genre == "خيال علمي":

        return (

            "خيال علمي" in genres

            or

            "خيال علمي وفانتازيا" in genres

        )


    if wanted_genre == "مغامرة":

        return (

            "مغامرة" in genres

            or

            "أكشن ومغامرة" in genres

        )


    if wanted_genre == "فانتازيا":

        return (

            "فانتازيا" in genres

            or

            "خيال علمي وفانتازيا" in genres

        )


    return False


# =========================================================
# POPULARITY
# =========================================================

def get_popularity(
    item
):

    try:

        return float(
            item.get(
                "popularity",
                0
            )
            or 0
        )

    except (
        TypeError,
        ValueError
    ):

        return 0.0


# =========================================================
# VOTE COUNT
# =========================================================

def get_vote_count(
    item
):

    try:

        return int(
            item.get(
                "vote_count",
                0
            )
            or 0
        )

    except (
        TypeError,
        ValueError
    ):

        return 0


# =========================================================
# RATING
# =========================================================

def get_rating(
    item
):

    try:

        rating = float(
            item.get(
                "rating",
                0
            )
            or 0
        )


        if rating <= 0:

            return "—"


        return (
            f"{rating:.1f}/10"
        )


    except (
        TypeError,
        ValueError
    ):

        return "—"


# =========================================================
# SHORT OVERVIEW
# =========================================================

def build_short_overview(
    item
):

    overview = clean_text(
        item.get(
            "overview",
            ""
        )
    )


    if not overview:

        return (
            "اكتشف قصة هذا العمل "
            "وتفاصيله على MOVINS."
        )


    if len(
        overview
    ) <= MAX_OVERVIEW_LENGTH:

        return overview


    shortened = overview[
        :MAX_OVERVIEW_LENGTH
    ]


    if " " in shortened:

        shortened = shortened.rsplit(
            " ",
            1
        )[0]


    return shortened + "..."


# =========================================================
# HASHTAGS
# =========================================================

def build_hashtags(
    item
):

    tags = [

        "#MOVINS",

        "#افلام",

        "#مسلسلات",

        "#سينما",

        "#Movie"

    ]


    media_type = get_media_type(
        item
    )


    if media_type == "movie":

        tags.append(
            "#Movies"
        )

    else:

        tags.append(
            "#Series"
        )


    for genre in get_genres_list(
        item
    )[:2]:

        genre_tag = (
            genre
            .replace(
                " ",
                "_"
            )
        )


        if genre_tag:

            tags.append(
                "#" + genre_tag
            )


    unique = []


    for tag in tags:

        if tag not in unique:

            unique.append(
                tag
            )


    return " ".join(
        unique[:10]
    )


# =========================================================
# INSTAGRAM CAPTION
# =========================================================

def build_caption(
    item
):

    title = clean_text(
        item.get(
            "title"
        )
        or "بدون عنوان"
    )


    overview = build_short_overview(
        item
    )


    year = clean_text(
        item.get(
            "year"
        )
        or "—"
    )


    genres = " • ".join(
        get_genres_list(
            item
        )[:3]
    )


    media_type = get_arabic_type(
        get_media_type(item)
    )


    rating = get_rating(
        item
    )


    hashtags = build_hashtags(
        item
    )


    lines = [

        f"🎬 {title}",

        "",

        overview,

        "",

        f"⭐ التقييم: {rating}",

        f"🎭 {media_type}",

        f"🎞️ {genres or 'غير محدد'}",

        f"📅 {year}",

        "",

        "🍿 هل ستشاهده؟",

        "👇 تابع MOVINS للمزيد من الأفلام والمسلسلات",

        "",

        hashtags

    ]


    return "\n".join(
        lines
    )


# =========================================================
# SELECT CANDIDATES
# =========================================================

def select_candidates(
    movies,
    posted,
    wanted_type,
    wanted_genre
):

    candidates = []


    for item in movies:

        key = get_movie_key(
            item
        )


        if not key:

            continue


        if key in posted:

            continue


        if (

            get_media_type(
                item
            )

            != wanted_type

        ):

            continue


        if not genre_matches(
            item,
            wanted_genre
        ):

            continue


        candidates.append(
            item
        )


    candidates.sort(

        key=lambda item: (

            get_popularity(
                item
            ),

            get_vote_count(
                item
            )

        ),

        reverse=True

    )


    return candidates


