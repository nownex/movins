# =========================================================
# CREATE INSTAGRAM CONTAINER
# =========================================================

def create_media_container(
    image_url,
    caption
):

    url = (

        f"{BASE_GRAPH_URL}/"

        f"{INSTAGRAM_USER_ID}/media"

    )


    payload = {

        "image_url":
            image_url,

        "caption":
            caption,

        "access_token":
            TOKEN

    }


    try:

        response = requests.post(

            url,

            data=payload,

            timeout=60

        )


    except requests.RequestException as error:

        print(
            "Instagram request error:",
            error
        )

        return ""


    try:

        result = response.json()

    except ValueError:

        print(
            "Instagram returned invalid JSON:"
        )

        print(
            response.text
        )

        return ""


    if not response.ok:

        print(
            "Instagram API Error:"
        )

        print(
            json.dumps(
                result,
                ensure_ascii=False,
                indent=2
            )
        )

        return ""


    return clean_text(
        result.get(
            "id"
        )
    )


# =========================================================
# PUBLISH INSTAGRAM CONTAINER
# =========================================================

def publish_media_container(
    creation_id
):

    url = (

        f"{BASE_GRAPH_URL}/"

        f"{INSTAGRAM_USER_ID}/media_publish"

    )


    payload = {

        "creation_id":
            creation_id,

        "access_token":
            TOKEN

    }


    try:

        response = requests.post(

            url,

            data=payload,

            timeout=60

        )


    except requests.RequestException as error:

        print(
            "Instagram publish error:",
            error
        )

        return False


    try:

        result = response.json()

    except ValueError:

        print(
            "Instagram returned invalid JSON:"
        )

        print(
            response.text
        )

        return False


    if not response.ok:

        print(
            "Instagram API Error:"
        )

        print(
            json.dumps(
                result,
                ensure_ascii=False,
                indent=2
            )
        )

        return False


    print(
        "Instagram post successful."
    )


    print(
        "Instagram Media ID:",
        result.get(
            "id"
        )
    )


    return True


# =========================================================
# PUBLISH TO INSTAGRAM
# =========================================================

def publish_to_instagram(
    item
):

    poster = clean_text(
        item.get(
            "poster",
            ""
        )
    )


    if not poster:

        print(
            "SKIP: no poster"
        )

        return False


    caption = build_caption(
        item
    )


    print(
        "======================================"
    )


    print(
        "PUBLISHING TO INSTAGRAM"
    )


    print(
        "======================================"
    )


    print(
        f"Title: "
        f"{item.get('title', '')}"
    )


    print(
        f"Type: "
        f"{item.get('type', '')}"
    )


    print(
        f"Poster: "
        f"{poster}"
    )


    print(
        "======================================"
    )


    print(
        "Creating Instagram media container..."
    )


    creation_id = create_media_container(

        poster,

        caption

    )


    if not creation_id:

        print(
            "Failed to create "
            "Instagram media container."
        )

        return False


    print(
        f"Container created: "
        f"{creation_id}"
    )


    print(
        "Publishing Instagram media..."
    )


    return publish_media_container(
        creation_id
    )


# =========================================================
# MAIN
# =========================================================

def main():

    print(
        "======================================"
    )


    print(
        "MOVINS INSTAGRAM PUBLISHER"
    )


    print(
        "======================================"
    )


    movies = load_movies()

    posted = load_posted()

    rotation = load_rotation()


    rotation_index = (

        rotation.get(
            "index",
            0
        )

        % len(
            ROTATION_SEQUENCE
        )

    )


    current = (

        ROTATION_SEQUENCE[
            rotation_index
        ]

    )


    wanted_type = (
        current[
            "type"
        ]
    )


    wanted_genre = (
        current[
            "genre"
        ]
    )


    print(
        f"Current type: "
        f"{get_arabic_type(wanted_type)}"
    )


    print(
        f"Current genre: "
        f"{wanted_genre}"
    )


    # =====================================================
    # PRIMARY
    # =====================================================

    candidates = select_candidates(

        movies,

        posted,

        wanted_type,

        wanted_genre

    )


    # =====================================================
    # TYPE FALLBACK
    # =====================================================

    if not candidates:

        print(
            "No exact match."
        )


        candidates = select_type_fallback(

            movies,

            posted,

            wanted_type

        )


    # =====================================================
    # GLOBAL FALLBACK
    # =====================================================

    if not candidates:

        print(
            "No type match."
        )


        candidates = select_global_fallback(

            movies,

            posted

        )


    if not candidates:

        print(
            "No new movies available."
        )

        return


    # =====================================================
    # SELECT
    # =====================================================

    selected = candidates[0]


    print(
        "======================================"
    )


    print(
        "SELECTED FOR INSTAGRAM"
    )


    print(
        f"Title: "
        f"{selected.get('title', '')}"
    )


    print(
        f"Type: "
        f"{selected.get('type', '')}"
    )


    print(
        f"Genre: "
        f"{' • '.join(get_genres_list(selected))}"
    )


    print(
        "======================================"
    )


    # =====================================================
    # PUBLISH
    # =====================================================

    success = publish_to_instagram(
        selected
    )


    if not success:

        print(
            "Instagram publishing failed."
        )

        return


    # =====================================================
    # SAVE POSTED
    # =====================================================

    movie_key = get_movie_key(
        selected
    )


    posted.add(
        movie_key
    )


    save_posted(
        posted
    )


    # =====================================================
    # NEXT ROTATION
    # =====================================================

    next_index = (

        rotation_index + 1

    ) % len(
        ROTATION_SEQUENCE
    )


    save_rotation({

        "index":
            next_index

    })


    next_rotation = (

        ROTATION_SEQUENCE[
            next_index
        ]

    )


    print(
        "======================================"
    )


    print(
        "INSTAGRAM PUBLISHING SUCCESSFUL"
    )


    print(
        f"Next type: "
        f"{get_arabic_type(next_rotation['type'])}"
    )


    print(
        f"Next genre: "
        f"{next_rotation['genre']}"
    )


    print(
        "======================================"
    )


# =========================================================
# START
# =========================================================

if __name__ == "__main__":

    main()
